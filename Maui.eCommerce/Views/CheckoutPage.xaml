<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Maui.eCommerce.ViewModels"
             x:Class="Maui.eCommerce.Views.CheckoutPage"
             Title="Checkout">

    <ContentPage.BindingContext>
        <viewmodels:CheckoutViewModel />
    </ContentPage.BindingContext>

    <StackLayout Padding="20" Spacing="15">
        <Label Text="Checkout Receipt"
               FontSize="24"
               HorizontalOptions="Center" />

        <CollectionView ItemsSource="{Binding CartItems}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout Orientation="Horizontal" Spacing="10">
                        <Label Text="{Binding Product.Name}" FontSize="16" />
                        <Label Text="x" FontSize="16" />
                        <Label Text="{Binding Quantity}" FontSize="16" />
                        <Label Text="{Binding Product.Price, StringFormat='${0:F2}'}" FontSize="16" />
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Text="{Binding SubtotalFormatted}" FontSize="18" />
        <Label Text="{Binding TaxFormatted}" FontSize="18" />
        <Label Text="{Binding TotalFormatted}" FontSize="20" FontAttributes="Bold" />
        
    </StackLayout>
</ContentPage>